NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYU_URL=https://secure.payu.in/_payment

# Server-only secrets (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=
OPENROUTER_WORKSPACE_ID=
BLUE_RUNTIME_TOKEN_ENCRYPTION_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL_TO=

# Direct runtime capacity and rollout
ENABLE_LEGACY_AI_PROXY=false
BLUE_DIRECT_RUNTIME_ENABLED=true
GLOBAL_AI_CONCURRENCY_LIMIT=100
BLUE_RUNTIME_QUEUE_LIMIT=500
BLUE_RUNTIME_QUEUE_TIMEOUT_SECONDS=120
BLUE_RUNTIME_RETRY_AFTER_MS=2500
BLUE_RUNTIME_USAGE_OBSERVATION_INTERVAL_MS=5000
BLUE_RUNTIME_USAGE_SETTLEMENT_GRACE_MS=30000
BLUE_RUNTIME_ZERO_USAGE_SETTLEMENT_GRACE_MS=120000
BLUE_CREDIT_MULTIPLIER=1.5

# Emergency kill switches
DISABLE_AI_ADMISSION=false
DISABLE_NEW_OTP=false
DISABLE_CHECKOUT=false

# Legacy SMTP jobs (migrate remaining campaigns to the Resend outbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
